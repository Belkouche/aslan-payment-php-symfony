{
  "name": "aslan/payment-php",
  "description": "Official PHP SDK for the Aslan Payment API",
  "type": "library",
  "license": "MIT",
  "version": "0.1.0",
  "keywords": ["aslan", "payment", "sdk", "morocco", "mad", "api", "symfony"],
  "homepage": "https://aslanpay.ma",
  "authors": [
    {
      "name": "Aslan Pay",
      "email": "dev@aslanpay.ma",
      "homepage": "https://aslanpay.ma"
    }
  ],
  "require": {
    "php": ">=8.1",
    "symfony/http-client": "^6.0|^7.0",
    "symfony/contracts": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "symfony/http-client": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "Aslan\\Payment\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Aslan\\Payment\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.1.x-dev"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage-html coverage/"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
