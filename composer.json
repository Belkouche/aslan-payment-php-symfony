{
  "name": "aslan/payment-php",
  "description": "Official PHP SDK for the Aslan Payment API",
  "type": "library",
  "license": "MIT",
  "version": "0.2.0",
  "keywords": ["aslan", "payment", "sdk", "morocco", "mad", "api", "symfony"],
  "homepage": "https://aslanpay.ma",
  "authors": [
    {
      "name": "Aslan Pay",
      "email": "dev@aslanpay.ma",
      "homepage": "https://aslanpay.ma"
    }
  ],
  "require": {
    "php": "~8.2.35 || ~8.3.36 || ~8.4.27 || >=8.5.12",
    "symfony/contracts": "^3.5",
    "symfony/http-client": "^6.4.15 || ^7.4 || ^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5.50"
  },
  "autoload": {
    "psr-4": {
      "Aslan\\Payment\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Aslan\\Payment\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.2.x-dev"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage-html coverage/"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
